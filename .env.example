# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Required for real Google sign-in. Without it, a demo Google account is used.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Laravel API base URL (no trailing slash). Leave empty to use mock data.
# VITE_API_URL=http://localhost:8000

VITE_BASE_URL=
VITE_API_BASE_URL=
VITE_API_KEY=
VITE_SECRET_KEY=

VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=
